# ─────────────────────────────────────────────────────────────
# ProspectAI environment variables
# Copy this file to .env.local and fill in values for local development.
# Never commit real secrets. Never expose service-role keys to the browser.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ProspectAI

# Development-only: show labelled sample dashboard records when the database
# is empty. Never enable this in production. Sample records are not real businesses.
NEXT_PUBLIC_DEV_PREVIEW_DATA=true

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI providers (provider-independent layer in src/lib/ai) ─
# Grok (xAI) is the default provider. Leave blank until credentials exist.
GROK_API_KEY=
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-fast-reasoning
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DEFAULT_PROVIDER=grok

# ── Business discovery ──────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=ProspectAI <noreply@localhost>

# ── WhatsApp Cloud API (optional; outreach fails closed without it) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Payments (Moolre is the Ghana provider) ─────────────────
MOOLRE_API_USER=
MOOLRE_PUBLIC_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WALLET_SECRET=
MOOLRE_API_BASE_URL=https://api.moolre.com
# Optional international later — not used for Ghana checkout
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Platform admin ──────────────────────────────────────────
# Comma-separated emails treated as platform admin in addition to
# profiles.platform_role. Empty means only database roles can open /admin.
# The labelled local session email is kofi@prospectai.com.
PLATFORM_ADMIN_EMAILS=

# ── Background jobs ─────────────────────────────────────────
TRIGGER_SECRET_KEY=
